---
import Layout from '../layouts/Layout.astro';

import { CHAPTERS, STAGES, NEWS } from '../data/chapters.js';

// Kapitoly a etapy žijí v src/data/chapters.js (sdílí je i patička kapitol).
// Zobrazí se jen kapitoly, jejichž stránka existuje.
// ?raw: jen seznam souborů — bez něj by Astro přibalilo CSS všech stránek
const PAGES = import.meta.glob('./*.astro', { query: '?raw' });
const examples = CHAPTERS.filter(c => `./${c.slug}.astro` in PAGES);
const stages = STAGES.map(s => ({ ...s, links: examples.filter(c => +c.n >= +s.from && +c.n <= +s.to).map(c => c.slug) }))
  .filter(s => s.links.length);
---
<Layout titleCs="Základy umělé inteligence — rozcestník" titleEn="Foundations of artificial intelligence — overview">
<style is:global>
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    margin: 0; min-height: 100vh; color: #1c1c1e;
    background: linear-gradient(160deg, #eef2ff 0%, #f4f5f7 40%, #ecfdf5 100%);
    display: flex; flex-direction: column; align-items: center;
    padding: 56px 16px 64px;
  }
  header { text-align: center; margin-bottom: 44px; max-width: 680px; }
  header .kicker {
    font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
    color: #2563eb; margin-bottom: 10px;
  }
  header h1 { font-size: 34px; font-weight: 800; margin: 0 0 12px; letter-spacing: -0.02em; }
  header p { font-size: 15px; line-height: 1.6; color: #6b7280; margin: 0; }

  .grid {
    display: grid; gap: 22px; width: min(900px, 100%);
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }

  .card {
    position: relative; display: flex; flex-direction: column;
    background: #fff; border: 1px solid #e8eaef; border-radius: 18px;
    padding: 26px 24px; text-decoration: none; color: inherit; overflow: hidden;
    box-shadow: 0 4px 18px rgba(17,24,39,0.05);
    transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease;
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 36px rgba(17,24,39,0.12);
    border-color: #c7d2fe;
  }
  /* accent barva teď přichází inline z dat (style="background:…") — žádné .c1..c15 */
  .card .accent { position: absolute; inset: 0 auto 0 0; width: 6px; }

  .card .num {
    font-family: "SF Mono", Menlo, Consolas, monospace;
    font-size: 13px; font-weight: 700; color: #9ca3af; margin-bottom: 14px;
  }
  .card .icon { font-size: 38px; line-height: 1; margin-bottom: 16px; }
  .card h2 { font-size: 20px; margin: 0 0 8px; font-weight: 700; }
  .card p { font-size: 14px; line-height: 1.55; color: #6b7280; margin: 0 0 20px; flex: 1; }

  .card .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 18px; }
  .card .tags span {
    font-size: 11px; font-weight: 600; color: #4b5563;
    background: #f3f4f6; border-radius: 999px; padding: 4px 10px;
  }
  .card .go {
    align-self: flex-start; font-size: 14px; font-weight: 700; color: #2563eb;
    display: inline-flex; align-items: center; gap: 6px;
  }
  .card .go .arrow { transition: transform .16s ease; }
  .card:hover .go .arrow { transform: translateX(4px); }

  /* ── Cesta sérií (oblouk) ── */
  .journey { width: min(900px, 100%); margin-top: 8px; margin-bottom: 48px; }
  .journey .jhead { text-align: center; margin-bottom: 30px; }
  .journey .jhead h2 { font-size: 24px; font-weight: 800; margin: 0 0 8px; letter-spacing: -0.01em; }
  .journey .jhead p { font-size: 14px; color: #6b7280; margin: 0 auto; max-width: 560px; line-height: 1.55; }

  .timeline { position: relative; padding-left: 8px; }
  /* svislá spojnice */
  .timeline::before {
    content: ""; position: absolute; left: 27px; top: 8px; bottom: 8px; width: 3px;
    background: linear-gradient(180deg,#111827,#2563eb 35%,#16a34a 60%,#a855f7 100%);
    border-radius: 3px;
  }
  .stage { position: relative; display: flex; gap: 20px; padding: 0 0 26px 0; }
  .stage:last-child { padding-bottom: 0; }
  .stage .node {
    flex: 0 0 auto; width: 50px; height: 50px; border-radius: 50%;
    background: #fff; border: 3px solid var(--c); color: var(--c);
    display: flex; align-items: center; justify-content: center; font-size: 22px;
    box-shadow: 0 2px 10px rgba(17,24,39,0.08); z-index: 1;
  }
  .stage .body {
    background: #fff; border: 1px solid #e8eaef; border-radius: 14px;
    padding: 16px 20px; flex: 1; box-shadow: 0 2px 12px rgba(17,24,39,0.04);
  }
  .stage .body .pills { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 8px; }
  .stage .body .pills a {
    font-family: "SF Mono", Menlo, Consolas, monospace; font-size: 11px; font-weight: 700;
    color: #fff; background: var(--c); border-radius: 6px; padding: 3px 9px; text-decoration: none;
    opacity: .9; transition: opacity .12s, transform .05s;
  }
  .stage .body .pills a:hover { opacity: 1; transform: translateY(-1px); }
  .stage .body h3 { margin: 0 0 5px; font-size: 16px; font-weight: 700; }
  .stage .body p { margin: 0; font-size: 13.5px; color: #6b7280; line-height: 1.5; }
  .stage .body p b { color: #374151; }

  @media (max-width: 560px) {
    .timeline::before { left: 22px; }
    .stage .node { width: 42px; height: 42px; font-size: 18px; }
  }

  footer { margin-top: 48px; font-size: 13px; color: #9ca3af; text-align: center; }

  /* Co je nového */
  .news { width: min(900px, 100%); margin: -20px 0 40px; background: #fff; border: 1px solid #c7d2fe;
    border-left: 5px solid #2563eb; border-radius: 14px; padding: 14px 20px; box-shadow: 0 2px 12px rgba(37,99,235,0.08); }
  .news .nhead { font-size: 12px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: #2563eb; margin-bottom: 6px; }
  .news p { margin: 0; font-size: 14px; line-height: 1.6; color: #4b5563; }
  .news p b { color: #111827; }
  .stage .body .years { font-size: 11px; font-weight: 700; color: var(--c); letter-spacing: .04em; margin-left: 4px; }
</style>

  <header>
    <div class="kicker"><span class="cs">Demonstrace · ICT / AI</span><span class="en">Demonstrations · ICT / AI</span></div>
    <h1><span class="cs">Základy umělé inteligence</span><span class="en">Foundations of artificial intelligence</span></h1>
    <p>
      <span class="cs">Interaktivní ukázky, které krok po kroku odhalují principy za AI — od holé kombinatoriky
      a hranic hrubé síly přes učení z dat až k tomu, jak fungují dnešní jazykové modely, RAG a agenti.
      Sledujeme dvě tradice AI: <b>ručně psaná pravidla</b> a <b>učení z dat</b> — a proč nakonec vyhrála ta druhá.</span>
      <span class="en">Interactive demos that reveal the principles behind AI step by step — from bare
      combinatorics and the limits of brute force, through learning from data, to how today's language models, RAG and agents work.
      We follow two traditions of AI: <b>hand-written rules</b> and <b>learning from data</b> — and why the second one won.</span>
    </p>
  </header>

  <section class="news">
    <div class="nhead"><span class="cs">Co je nového · verze {NEWS.version}</span><span class="en">What's new · version {NEWS.version}</span></div>
    <p><span class="cs" set:html={NEWS.cs}></span><span class="en" set:html={NEWS.en}></span></p>
  </section>

  <section class="journey">
    <div class="jhead">
      <h2><span class="cs">Jak série postupuje</span><span class="en">How the series unfolds</span></h2>
      <p><span class="cs">Příklady na sebe navazují — každý vyřeší hranici toho předchozího. Dohromady tvoří
         cestu od holého počítání až k principům dnešních jazykových modelů.</span>
         <span class="en">The examples build on each other — each one solves the limitation of the last.
         Together they trace a path from bare counting to the principles behind today's language models.</span></p>
    </div>

    <div class="timeline">
      {stages.map((s) => (
        <div class="stage" style={`--c:${s.c}`}>
          <div class="node">{s.icon}</div>
          <div class="body">
            <div class="pills">{s.links.map((slug) => <a href={`${slug}.html`}>{slug.slice(0, 2)}</a>)}</div>
            <h3><span class="cs">{s.titleCs}</span><span class="en">{s.titleEn}</span>
              <span class="years"><span class="cs">{s.years}</span><span class="en">{s.yearsEn ?? s.years}</span></span></h3>
            <p><span class="cs" set:html={s.proseCs}></span><span class="en" set:html={s.proseEn}></span></p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <main class="grid">
    {examples.map((e) => (
      <a class="card" href={`${e.slug}.html`}>
        <span class="accent" style={`background:${e.accent}`}></span>
        <div class="num">
          <span class="cs">Příklad {e.n}{e.bonus ? ' · bonus' : ''}</span>
          <span class="en">Example {e.n}{e.bonus ? ' · bonus' : ''}</span>
        </div>
        <div class="icon">{e.icon}</div>
        <h2><span class="cs">{e.titleCs}</span><span class="en">{e.titleEn}</span></h2>
        <p><span class="cs">{e.descCs}</span><span class="en">{e.descEn}</span></p>
        <div class="tags">
          {e.tags.map((t) => t.t
            ? <span>{t.t}</span>
            : <Fragment><span class="cs">{t.cs}</span><span class="en">{t.en}</span></Fragment>)}
        </div>
        <span class="go"><span class="cs">Otevřít ukázku</span><span class="en">Open demo</span> <span class="arrow">→</span></span>
      </a>
    ))}
  </main>

  <footer>
    <span class="cs">SSST 2026 · ICT / AI &nbsp;·&nbsp; otevři kteroukoli ukázku přímo v prohlížeči</span>
    <span class="en">SSST 2026 · ICT / AI &nbsp;·&nbsp; open any demo straight in your browser</span>
  </footer>
</Layout>
